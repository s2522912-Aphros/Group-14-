"""
GEO Satellite Total Lifetime Efficiency Model
---------------------------------------------
This Python script simulates the total lifetime efficiency of a geostationary
satellite’s solar power subsystem, following the data and methodology presented
by Dr. T. S. Kelso in *More on the Geostationary Orbit* (CelesTrak).

Four multiplicative efficiency factors are modelled:
1) Earth–Sun distance variation (~±3.3%)
2) Solar declination angle (cos δ effect)
3) Eclipse seasons around equinoxes (up to ~70 minutes/day shadow)
4) Long-term degradation:
   - Optical coating: −7% in the first year, then stable
   - Solar cells: −3% in the first year, then −2% per subsequent year

Outputs:
- Daily efficiency over 7 years (CSV)
- Annual summary (min/mean/max, CSV + console output)
- Plots:
    * geo_total_efficiency_daily.png  — 7-year total efficiency curve
    * geo_total_efficiency_year1_components.png — Year-1 efficiency components
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from dataclasses import dataclass
from datetime import datetime, timedelta


# ================================================================
# Configuration
# ================================================================
@dataclass
class ModelConfig:
    start_year: int = 2025
    years: int = 7
    # Eclipse season parameters
    eclipse_halfwidth_days: float = 22.5     # each season ±22.5 days (~45 total)
    eclipse_peak_minutes: float = 70.0       # max shadow duration at equinox
    # Declination model
    decl_amp_deg: float = 23.44              # Earth’s axial tilt
    decl_phase_shift_day: int = 80           # spring equinox ~ day 80
    # Earth–Sun distance model
    ecc_amp: float = 0.033                   # ±3.3%
    ecc_perihelion_shift_day: int = 3        # perihelion ~ Jan 3
    # Degradation model
    optical_drop_year1: float = 0.07         # −7% first year (optical cover)
    cell_drop_year1: float = 0.03            # −3% first year (solar cells)
    cell_drop_each_later_year: float = 0.02  # −2% each later year
    # Output file prefix
    out_prefix: str = "geo_total_efficiency"


# ================================================================
# Helper functions
# ================================================================
def to_doy(d: datetime) -> int:
    """Return day-of-year (1..365)."""
    return (d - datetime(d.year, 1, 1)).days + 1


def solar_distance_eff(n, amp=0.033, shift=3):
    """Efficiency due to Earth–Sun distance: 1 + 0.033*cos(2π(n−3)/365)."""
    n = np.asarray(n, dtype=float)
    return 1.0 + amp * np.cos(2 * np.pi * (n - shift) / 365.0)


def solar_angle_eff(n, decl_amp_deg=23.44, phase_shift=80):
    """Efficiency reduction from solar declination δ (cos δ)."""
    n = np.asarray(n, dtype=float)
    delta_deg = decl_amp_deg * np.sin(2 * np.pi * (n - phase_shift) / 365.0)
    return np.cos(np.deg2rad(delta_deg))


def eclipse_eff(n, centers=(80, 263), halfwidth=22.5, max_minutes=70.0):
    """
    Eclipse efficiency reduction during equinoxes.
    Two cosine windows centered on day 80 and 263 (spring & autumn equinox).
    Width = ±halfwidth; peak shadow = max_minutes/day.
    """
    n = np.asarray(n, dtype=float)
    eclipse_minutes = np.zeros_like(n, dtype=float)
    for c in centers:
        d = np.abs(((n - c + 182.5) % 365) - 182.5)
        w = np.where(d <= halfwidth, 0.5 * (1 + np.cos(np.pi * d / halfwidth)), 0.0)
        eclipse_minutes += max_minutes * w
    return 1.0 - eclipse_minutes / (24.0 * 60.0)


def degradation_eff(day_index,
                    optical_drop_year1=0.07,
                    cell_drop_year1=0.03,
                    cell_drop_each_later_year=0.02):
    """
    Long-term degradation:
      Optical coating: ×(1−0.07) after year 1, stable.
      Solar cells: ×(1−0.03) year 1, then ×(1−0.02)^year_num.
    """
    day_index = np.asarray(day_index, dtype=int)
    year_num = day_index // 365
    optical = np.where(year_num == 0, 1.0, 1.0 - optical_drop_year1)
    cells = (1.0 - cell_drop_year1) * np.power((1.0 - cell_drop_each_later_year), year_num)
    return optical * cells


# ================================================================
# Main model
# ================================================================
def build_timeseries(cfg: ModelConfig) -> pd.DataFrame:
    start_date = datetime(cfg.start_year, 1, 1)
    total_days = cfg.years * 365  # simplified: 365 days per year
    dates = [start_date + timedelta(days=i) for i in range(total_days)]
    doy = np.array([((to_doy(d) - 1) % 365) + 1 for d in dates])
    day_idx = np.arange(total_days)

    dist = solar_distance_eff(doy, cfg.ecc_amp, cfg.ecc_perihelion_shift_day)
    angle = solar_angle_eff(doy, cfg.decl_amp_deg, cfg.decl_phase_shift_day)
    ecl = eclipse_eff(doy, (80, 263), cfg.eclipse_halfwidth_days, cfg.eclipse_peak_minutes)
    deg = degradation_eff(day_idx, cfg.optical_drop_year1,
                          cfg.cell_drop_year1, cfg.cell_drop_each_later_year)

    total = dist * angle * ecl * deg
    total = np.clip(total, 0.0, 1.2)

    df = pd.DataFrame({
        "date": dates,
        "day_of_year": doy,
        "distance_eff": dist,
        "angle_eff": angle,
        "eclipse_eff": ecl,
        "degradation_eff": deg,
        "total_eff": total
    }).set_index("date")

    return df


def annual_summary(df: pd.DataFrame) -> pd.DataFrame:
    """Compute annual min/mean/max of total efficiency."""
    summary = df["total_eff"].resample("Y").agg(["min", "mean", "max"])
    summary.index = summary.index.year
    return summary


def plot_total(df: pd.DataFrame, cfg: ModelConfig) -> str:
    """Plot full 7-year total efficiency curve."""
    path = f"{cfg.out_prefix}_daily.png"
    plt.figure(figsize=(12, 5))
    plt.plot(df.index, df["total_eff"])
    plt.title(f"Total Lifetime Efficiency — GEO Satellite ({cfg.years} Years)")
    plt.xlabel("Date")
    plt.ylabel("Efficiency (fraction of initial)")
    plt.tight_layout()
    plt.savefig(path, dpi=200)
    plt.show()
    return path


def plot_components_year1(df: pd.DataFrame, cfg: ModelConfig) -> str:
    """Plot year-1 component efficiencies."""
    path = f"{cfg.out_prefix}_year1_components.png"
    end = df.index.min() + timedelta(days=365)
    mask = df.index < end
    plt.figure(figsize=(12, 5))
    plt.plot(df.index[mask], df.loc[mask, "distance_eff"], label="Distance")
    plt.plot(df.index[mask], df.loc[mask, "angle_eff"], label="Angle")
    plt.plot(df.index[mask], df.loc[mask, "eclipse_eff"], label="Eclipse")
    plt.plot(df.index[mask], df.loc[mask, "degradation_eff"], label="Degradation")
    plt.legend()
    plt.title("Year 1 Efficiency Components (Daily)")
    plt.xlabel("Date")
    plt.ylabel("Efficiency factor")
    plt.tight_layout()
    plt.savefig(path, dpi=200)
    plt.show()
    return path


# ================================================================
# Entry point
# ================================================================
def main():
    cfg = ModelConfig(start_year=2025, years=7)
    df = build_timeseries(cfg)

    # Save daily data
    csv_path = f"{cfg.out_prefix}_daily_{cfg.start_year}_{cfg.start_year + cfg.years - 1}.csv"
    df.to_csv(csv_path)
    print(f"[OK] Saved daily data -> {csv_path}")

    # Annual summary
    ann = annual_summary(df)
    ann_path = f"{cfg.out_prefix}_annual_summary.csv"
    ann.to_csv(ann_path)
    print(f"[OK] Saved annual summary -> {ann_path}\n")
    print("Annual min/mean/max:")
    print(ann.round(4))

    # Plot results
    p1 = plot_total(df, cfg)
    p2 = plot_components_year1(df, cfg)
    print(f"[OK] Saved plots -> {p1}, {p2}")

    # Print range for verification
    min_eff = df["total_eff"].min()
    max_eff = df["total_eff"].max()
    mean_eff = df["total_eff"].mean()
    print(f"\nEfficiency range: {min_eff:.3f} – {max_eff:.3f}")
    print(f"Mean lifetime efficiency ≈ {mean_eff:.3f}")


if __name__ == "__main__":
    main()
